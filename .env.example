# Futureweb Intervals MCP configuration (copy to .env; never commit real values)

# Required: your Intervals.icu API key (Settings -> Developer Settings)
API_KEY=your_intervals_api_key_here

# Required: your Intervals.icu athlete ID (e.g. i123456 or 123456)
ATHLETE_ID=your_athlete_id_here

# Base URL (optional, defaults to https://intervals.icu/api/v1)
# INTERVALS_API_BASE_URL=https://intervals.icu/api/v1

# Tool permission classes exposed to clients (optional, default: read).
# read = never changes anything; write = create/edit calendar entries, notes, RPE/feel,
# subjective wellness and library workouts; destructive = delete events/custom items/library
# workouts; admin = create/update custom items and bulk calendar operations.
# Examples: MCP_PERMISSIONS=read  |  MCP_PERMISSIONS=read,write  |  MCP_PERMISSIONS=all
# MCP_PERMISSIONS=read

# Tool set (optional, default: full). core = a curated set of about 20 tools for clients with a
# small tool budget (see README "Tool sets"); MCP_PERMISSIONS still applies inside the set.
# MCP_TOOLSET=full

# Time zone for "today" and default date ranges (optional). Default: the timezone of the
# Intervals.icu athlete profile; "server" uses the server clock (the Docker image runs in UTC).
# ATHLETE_TIMEZONE=Europe/Vienna

# Limits of one tool call (optional): Intervals.icu requests, seconds, result size in characters.
# MCP_TOOL_MAX_REQUESTS=300
# MCP_TOOL_TIMEOUT_S=120
# MCP_MAX_OUTPUT_CHARS=100000

# Display units for custom item codes whose Intervals.icu definition has none or
# unspecific units (optional). Codes are the custom item codes of your account.
# CUSTOM_UNITS_OVERRIDES=Stamina=%,PotentialStamina=%,RecoveryTime=h

# Transport (optional): stdio (default, for Claude Desktop / Claude Code), sse or http.
# Network transports must never be exposed on public interfaces without an
# authenticating reverse proxy (see SECURITY.md).
# MCP_TRANSPORT=stdio
# FASTMCP_HOST=127.0.0.1
# FASTMCP_PORT=8000
# FASTMCP_LOG_LEVEL=INFO

# Secret endpoint path for remote use (the path acts as a credential; generate with
# `openssl rand -hex 24`), forwarded by the reverse proxy; see docs/REMOTE_ACCESS.md.
# FASTMCP_SSE_PATH=/mcp-<random>/sse
# FASTMCP_MESSAGE_PATH=/mcp-<random>/messages/
# Public Host header(s) accepted behind a reverse proxy (the host of MCP_PUBLIC_URL is added
# automatically); without it the MCP SDK answers 421 to proxied requests.
# FASTMCP_ALLOWED_HOSTS=mcp.example.com

# Built-in OAuth 2.1 server for ChatGPT / Claude (optional), see docs/REMOTE_ACCESS.md.
# MCP_TRANSPORT=http+sse
# MCP_AUTH=oauth
# MCP_PUBLIC_URL=https://mcp.example.com
# Sign in with Intervals.icu (app from https://intervals.icu/oauth/apply,
# redirect URL https://mcp.example.com/oauth/intervals/callback):
# INTERVALS_OAUTH_CLIENT_ID=
# INTERVALS_OAUTH_CLIENT_SECRET=
# OAUTH_ALLOWED_ATHLETES=i123456          # default: ATHLETE_ID
# ...or with the API_KEY above (default without app and password), and/or a password
# (hash: python -m intervals_mcp_server.auth hash-password):
# OAUTH_LOGIN=intervals,apikey,password
# OAUTH_USERNAME=athlete
# OAUTH_PASSWORD_HASH=pbkdf2_sha256$600000$...$...
# Optional authenticator code for password / API-key sign-in (python -m intervals_mcp_server.auth totp-secret):
# OAUTH_TOTP_SECRET=
# OAUTH_STATE_FILE=/var/lib/intervals-mcp/oauth_state.json
# Allowlists: a host (every path) or host/path (that document / that redirect path prefix).
# OAUTH_CLIENT_HOSTS=chatgpt.com,claude.ai,claude.com    # client metadata documents
# OAUTH_REDIRECT_HOSTS=chatgpt.com,claude.ai,claude.com  # dynamically registered clients
# Stricter, for example:
# OAUTH_CLIENT_HOSTS=chatgpt.com/oauth/client.json,claude.ai,claude.com
# (host/path is that exact path, host/path/ every path below it)
# OAUTH_REDIRECT_HOSTS=claude.ai/api/mcp/auth_callback,claude.com/api/mcp/auth_callback,chatgpt.com/connector_platform_oauth_redirect,chatgpt.com/connector/oauth/
# Refuse token requests without a signed client assertion from clients whose metadata
# document declares private_key_jwt (ChatGPT); default true.
# OAUTH_REQUIRE_PRIVATE_KEY_JWT=true
# Seconds a just-rotated refresh token still gets the same answer (client retry); later reuse
# revokes the grant unless OAUTH_REFRESH_REUSE_REVOKE=false (then only that request is refused).
# OAUTH_REFRESH_REUSE_GRACE=120
# OAUTH_REFRESH_REUSE_REVOKE=true
# Failed sign-ins: per client address (default 5) and, for password / API key, from all
# addresses together (default 500) per 15 minutes. The global budget can also be used by others
# to pause your password sign-in; with OAUTH_TOTP_SECRET it never blocks a sign-in.
# OAUTH_LOGIN_RATE_LIMIT=5
# OAUTH_LOGIN_GLOBAL_RATE_LIMIT=500
# Behind a reverse proxy that is not on 127.0.0.1 (uvicorn setting):
# FORWARDED_ALLOW_IPS=172.18.0.1

# Multi-user mode (optional): friends use the server with their own Intervals.icu data
# (README "Sharing the server with friends", docs/REMOTE_ACCESS.md section 5).
# Each connection then uses its own Intervals.icu token (stored encrypted); API_KEY only
# serves the owner (ATHLETE_ID) after the owner signed in. Needs MCP_AUTH=oauth and the
# Intervals.icu sign-in. Create the key: futureweb-intervals-mcp token-key --file <path>
# Before switching, confirm once that your single-user connections are yours:
#   futureweb-intervals-mcp grants adopt-legacy --owner
# MCP_TENANCY=multi
# OAUTH_TOKEN_KEY_FILE=/etc/intervals-mcp/token.key   # or OAUTH_TOKEN_KEY=<base64 key>
# OAUTH_LOGIN=intervals                               # password/apikey sign-in only with OAUTH_TOTP_SECRET
# OAUTH_ALLOWED_ATHLETES=i123456,i234567              # owner plus friends
# OAUTH_ALLOW_ANY_ATHLETE=false                       # true accepts OAUTH_ALLOWED_ATHLETES=* (anyone!)
# OAUTH_TOKEN_RETENTION_DAYS=0                        # drop tokens unused for N days (0 = refresh token lifetime only)
# OAUTH_MAX_GRANTS_PER_ATHLETE=5                      # connections kept per athlete
# INTERVALS_OAUTH_OFFER_CHATS=false                   # offer "Activity comments" (CHATS also covers private chats)
# INTERVALS_OAUTH_EXCLUDE_AREAS=                      # never request these Intervals.icu scope areas
# MCP_ATHLETE_DAILY_REQUESTS=1000                     # per athlete and day (0 = off)
# MCP_APP_REQUESTS_PER_15MIN=2000                     # all athletes together (0 = off)
# MCP_ATHLETE_SHARE_PERCENT=50                        # of the 15-minute budget, per athlete
# MCP_OWNER_RESERVED_PERCENT=20                       # of the 15-minute budget, kept for the owner
# Single-user mode: your own other Intervals.icu accounts allowed to sign in
# OAUTH_OWNER_ACCOUNTS=i555555
