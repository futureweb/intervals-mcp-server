# Futureweb Intervals MCP configuration (copy to .env; never commit real values)

# Required: your Intervals.icu API key (Settings -> Developer Settings)
API_KEY=your_intervals_api_key_here

# Required: your Intervals.icu athlete ID (e.g. i123456 or 123456)
ATHLETE_ID=your_athlete_id_here

# Base URL (optional, defaults to https://intervals.icu/api/v1)
# INTERVALS_API_BASE_URL=https://intervals.icu/api/v1

# Tool permission classes exposed to clients (optional, default: read).
# read = never changes anything; write = create/edit calendar entries, notes, RPE/feel,
# subjective wellness and library workouts; destructive = delete events/custom items/library
# workouts; admin = create/update custom items and bulk calendar operations.
# Examples: MCP_PERMISSIONS=read  |  MCP_PERMISSIONS=read,write  |  MCP_PERMISSIONS=all
# MCP_PERMISSIONS=read

# Display units for custom item codes whose Intervals.icu definition has none or
# unspecific units (optional). Codes are the custom item codes of your account.
# CUSTOM_UNITS_OVERRIDES=Stamina=%,PotentialStamina=%,RecoveryTime=h

# Transport (optional): stdio (default, for Claude Desktop / Claude Code), sse or http.
# Network transports must never be exposed on public interfaces without an
# authenticating reverse proxy (see SECURITY.md).
# MCP_TRANSPORT=stdio
# FASTMCP_HOST=127.0.0.1
# FASTMCP_PORT=8000
# FASTMCP_LOG_LEVEL=INFO
